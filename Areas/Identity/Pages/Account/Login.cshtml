@page
@model LoginModel

@{
    ViewData["Title"] = "تسجيل الدخول - نظام النخيل";
    Layout = null; // نلغي القالب الافتراضي لعرض صفحة دخول نظيفة ومستقلة
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
            padding: 2.5rem;
        }
        .brand-logo {
            font-size: 3rem;
            color: #1e3a8a;
            margin-bottom: 1rem;
        }
        .form-control {
            border-radius: 10px;
            padding: 0.75rem 1rem;
            border: 1px solid #dee2e6;
        }
        .form-control:focus {
            box-shadow: 0 0 0 0.25 darkblue;
            border-color: #1e3a8a;
        }
        .btn-login {
            background: #1e3a8a;
            border: none;
            border-radius: 10px;
            padding: 0.75rem;
            font-weight: bold;
            transition: all 0.3s;
        }
        .btn-login:hover {
            background: #152a61;
            transform: translateY(-2px);
        }
        .forgot-link {
            text-decoration: none;
            color: #6c757d;
            font-size: 0.85rem;
        }
        .forgot-link:hover { color: #1e3a8a; }
    </style>
</head>
<body>

<div class="login-card text-center">
    <div class="brand-logo">
        <i class="bi bi-palm-fill text-success"></i>
    </div>
    <h3 class="fw-bold mb-2">نظام النخيل الذكي</h3>
    <p class="text-muted mb-4">يرجى تسجيل الدخول للوصول إلى لوحة التحكم</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>
        
        <div class="mb-3 text-start">
            <label asp-for="Input.Email" class="form-label ms-2 small fw-bold">البريد الإلكتروني</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                <input asp-for="Input.Email" class="form-control border-start-0" autocomplete="username" placeholder="example@mail.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <div class="mb-3 text-start">
            <label asp-for="Input.Password" class="form-label ms-2 small fw-bold">كلمة المرور</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                <input asp-for="Input.Password" class="form-control border-start-0" autocomplete="current-password" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label small" asp-for="Input.RememberMe">تذكرني</label>
            </div>
            <a id="forgot-password" asp-page="./ForgotPassword" class="forgot-link">نسيت كلمة المرور؟</a>
        </div>

        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary btn-login mb-3">
            <i class="bi bi-box-arrow-in-right me-2"></i> دخول للنظام
        </button>
    </form>

    <div class="mt-3 pt-3 border-top">
        <p class="small text-muted mb-0">نظام النخيل لإدارة السوبرماركت &copy; 2026</p>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />

</body>
</html> 