@page
@model LogoutModel
@{
    ViewData["Title"] = "تسجيل الخروج";
    Layout = null; // لجعلها صفحة مستقلة وبسيطة
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f8f9fa;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .logout-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 3rem;
            max-width: 500px;
            width: 90%;
            text-align: center;
        }
        .icon-box {
            width: 80px;
            height: 80px;
            background: #eef2ff;
            color: #1e3a8a;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 2.5rem;
        }
    </style>
</head>
<body>

<div class="logout-card">
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="icon-box">
                <i class="bi bi-door-open"></i>
            </div>
            <h3 class="fw-bold mb-3">هل تريد تسجيل الخروج؟</h3>
            <p class="text-muted mb-4">سيتم إغلاق الجلسة الحالية وتأمين بياناتك.</p>
            
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm w-100">
                    <i class="bi bi-box-arrow-right me-2"></i> تأكيد الخروج الآن
                </button>
            </form>
            <a href="/" class="btn btn-link text-muted mt-3 text-decoration-none">إلغاء والعودة للوحة التحكم</a>
        }
        else
        {
            <div class="icon-box bg-success bg-opacity-10 text-success">
                <i class="bi bi-check2-circle"></i>
            </div>
            <h3 class="fw-bold mb-3 text-success">تم تسجيل الخروج بنجاح</h3>
            <p class="text-muted mb-4">شكراً لاستخدامك نظام النخيل. تم تأمين حسابك بنجاح.</p>
            <hr>
            <a asp-page="./Login" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                <i class="bi bi-person-lock me-2"></i> تسجيل دخول مرة أخرى
            </a>
        }
    }
</div>

</body>
</html>