@model List<alnakhil.ViewModels.PricingVM>

@{
    ViewData["Title"] = "إدارة التسعير";
}

<div class="container-fluid py-4 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border-start border-info border-5">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-tags me-2 text-info"></i> مراقبة وتعديل الأسعار</h3>
            <p class="text-muted small mb-0">قارن بين تكلفة الشراء وسعر البيع لضمان تحقيق هامش الربح المطلوب.</p>
        </div>
        <div class="btn-group shadow-sm">
            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-filter me-1"></i> تصفية</button>
            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1"></i> تصدير</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4 py-3">المنتج</th>
                        <th class="text-center">الكمية الحالية</th>
                        <th class="text-center">آخر سعر شراء</th>
                        <th class="text-center">سعر البيع الحالي</th>
                        <th class="text-center" style="width: 250px;">تعديل سعر البيع</th>
                        <th class="text-center">هامش الربح</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var hasCost = item.LastPurchasePrice > 0;
                        var profit = hasCost ? item.SalePrice - item.LastPurchasePrice : 0;
                        var markupPercent = hasCost ? (profit / item.LastPurchasePrice) * 100 : 0;
                        var marginPercent = (hasCost && item.SalePrice > 0) ? (profit / item.SalePrice) * 100 : 0;

                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.ProductName</div>
                                <small class="text-muted small">ID: #@item.ProductId</small>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill @(item.Quantity < 10 ? "bg-danger bg-opacity-10 text-danger" : "bg-light text-dark border")">
                                    @item.Quantity
                                </span>
                            </td>
                            <td class="text-center fw-bold">
                                @if (hasCost)
                                {
                                    <span class="text-muted">@item.LastPurchasePrice.ToString("N2")</span> <small class="text-muted">RY</small>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">غير مسجل</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="text-primary fw-bold">@item.SalePrice.ToString("N2")</span> <small class="text-muted">RY</small>
                            </td>
                            <td>
                                <form asp-action="Update" method="post" class="d-flex gap-2 justify-content-center">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <div class="input-group input-group-sm" style="width: 150px;">
                                        <input type="number" step="0.01" min="0.01" name="salePrice" value="@item.SalePrice" class="form-control border-info fw-bold text-center" required />
                                        <span class="input-group-text bg-info border-info text-white small">RY</span>
                                    </div>
                                    <button type="submit" class="btn btn-info btn-sm text-white px-3 shadow-sm" title="حفظ السعر">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                @if (hasCost)
                                {
                                    var isLoss = profit < 0;
                                    var isLow = !isLoss && markupPercent < 10;
                                    var colorClass = isLoss ? "text-danger" : (isLow ? "text-warning" : "text-success");
                                    var iconClass = isLoss ? "bi-arrow-down-right" : (isLow ? "bi-dash-lg" : "bi-arrow-up-right");

                                    <div class="small fw-bold @colorClass" title="هامش الربح من سعر البيع: @marginPercent.ToString("N1")%">
                                        <i class="bi @iconClass me-1"></i>
                                        @(profit >= 0 ? "+" : "")@markupPercent.ToString("N1")%
                                    </div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        صافي: @(profit >= 0 ? "+" : "")@profit.ToString("N2") RY
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">غير محدد</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .table tbody tr:hover { background-color: #f1f8ff !important; transition: 0.2s; }
    .input-group-text { font-size: 0.75rem; }
    .btn-info { background-color: #0dcaf0; border-color: #0dcaf0; }
    .btn-info:hover { background-color: #0baccc; border-color: #0baccc; }
</style>