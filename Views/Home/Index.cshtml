@model alnakhil.ViewModels.DashboardVM
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "الرئيسية";
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid px-3 px-md-4">

    <div class="p-3 p-md-4 mb-4 rounded-4 bg-white shadow-sm border-0 mt-2 mt-md-0">
        <div class="row align-items-center g-3"> 
            <div class="col-12 col-md text-center text-md-start"> 
                <h3 class="fw-bold mb-1 text-dark fs-4 fs-md-3">👋 أهلاً بك، @(user?.FullName ?? "مستخدم النخيل")</h3>
                <p class="text-muted mb-0 small">
                    @(isAdmin ? "إليك نظرة سريعة على أداء النظام اليوم" : "جاهز لبدء عمليات البيع؟")
                </p>
            </div>
            <div class="col-12 col-md-auto text-center">
                <a asp-controller="Sales" asp-action="Create" class="btn btn-primary-pos btn-lg w-100 px-md-5 shadow-sm">
                    <i class="bi bi-upc-scan me-2"></i> فاتورة بيع جديدة
                </a>
            </div>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 g-md-4 mb-4">
            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden text-white" style="background: linear-gradient(45deg, #4e73df, #224abe);">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 d-block mb-1 fw-bold">مبيعات اليوم</small>
                                <h3 class="fw-bold mb-0">@Model.TodaySales.ToString("N0") <small class="fs-6">ر.ي</small></h3>
                            </div>
                            <div class="icon-shape bg-white bg-opacity-25 rounded-3 p-2 p-md-3">
                                <i class="bi bi-graph-up-arrow fs-4 fs-md-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden text-white" style="background: linear-gradient(45deg, #36b9cc, #1a8a97);">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 d-block mb-1 fw-bold">أرباح الشهر</small>
                                <h3 class="fw-bold mb-0">@Model.MonthlyProfit.ToString("N0") <small class="fs-6">ر.ي</small></h3>
                            </div>
                            <div class="icon-shape bg-white bg-opacity-25 rounded-3 p-2 p-md-3">
                                <i class="bi bi-cash-stack fs-4 fs-md-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden text-white" style="background: linear-gradient(45deg, #e74a3b, #be2617);">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 d-block mb-1 fw-bold">ديون الموردين</small>
                                <h3 class="fw-bold mb-0">@Model.PayableDebts.ToString("N0") <small class="fs-6">ر.ي</small></h3>
                            </div>
                            <div class="icon-shape bg-white bg-opacity-25 rounded-3 p-2 p-md-3">
                                <i class="bi bi-person-dash fs-4 fs-md-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden text-white" style="background: linear-gradient(45deg, #f6c23e, #dda20a);">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 d-block mb-1 fw-bold">ديون العملاء</small>
                                <h3 class="fw-bold mb-0">@Model.ReceivableDebts.ToString("N0") <small class="fs-6">ر.ي</small></h3>
                            </div>
                            <div class="icon-shape bg-white bg-opacity-25 rounded-3 p-2 p-md-3">
                                <i class="bi bi-person-plus fs-4 fs-md-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-white border-start border-primary border-5 rounded-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <small class="text-muted fw-bold">إجمالي المنتجات</small>
                            <h4 class="fw-bold mb-0 text-dark">@Model.ProductsCount</h4>
                        </div>
                        <i class="bi bi-box-seam text-primary fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-white border-start border-warning border-5 rounded-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <small class="text-muted fw-bold">نواقص المخزن</small>
                            <h4 class="fw-bold mb-0 text-warning">@Model.LowStockCount</h4>
                        </div>
                        <i class="bi bi-graph-down-arrow text-warning fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-white border-start border-danger border-5 rounded-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <small class="text-muted fw-bold">قاربت الانتهاء</small>
                            <h4 class="fw-bold mb-0 text-danger">@Model.ExpiringSoonCount</h4>
                        </div>
                        <i class="bi bi-calendar-x text-danger fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-1 text-primary"></i> آخر المبيعات</h6>
                        <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-light fw-bold">عرض الكل</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small">
                                <tr>
                                    <th class="ps-3 border-0">الفاتورة</th>
                                    <th class="border-0">المبلغ</th>
                                    <th class="border-0 text-center">الحالة</th>
                                    <th class="pe-3 border-0 text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentSales != null && Model.RecentSales.Any()) {
                                    @foreach (var sale in Model.RecentSales.Take(5)) {
                                        <tr>
                                            <td class="ps-3 small fw-bold">#@sale.InvoiceNumber</td>
                                            <td class="small">@sale.TotalAmount.ToString("N0")</td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill @(sale.PaymentStatus == PaymentStatus.Paid ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-2">
                                                    @(sale.PaymentStatus == PaymentStatus.Paid ? "مدفوع" : "دين")
                                                </span>
                                            </td>
                                            <td class="pe-3 text-end">
                                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id" class="text-primary"><i class="bi bi-eye"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <h6 class="fw-bold mb-3 text-muted">إدارة سريعة</h6>
                    <div class="row g-2">
                        <div class="col-12">
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light w-100 text-start py-3 px-3 border-0 d-flex align-items-center gap-3 rounded-3 admin-action-btn">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle">
                                    <i class="bi bi-person-plus-fill text-primary"></i>
                                </div>
                                <div>
                                    <span class="d-block fw-bold">إضافة كاشير</span>
                                    <small class="text-muted">إنشاء حساب موظف جديد</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            <div class="col-6 col-md-3">
                <a asp-controller="Sales" asp-action="Create" class="card border-0 shadow-sm p-4 text-decoration-none h-100 cashier-card text-center">
                    <i class="bi bi-calculator fs-2 text-primary mb-2"></i>
                    <h6 class="fw-bold text-dark mb-0">نقطة البيع</h6>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Sales" asp-action="Index" class="card border-0 shadow-sm p-4 text-decoration-none h-100 cashier-card text-center">
                    <i class="bi bi-receipt-cutoff fs-2 text-success mb-2"></i>
                    <h6 class="fw-bold text-dark mb-0">فواتيري</h6>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Debts" asp-action="Index" class="card border-0 shadow-sm p-4 text-decoration-none h-100 cashier-card text-center">
                    <i class="bi bi-person-lines-fill fs-2 text-warning mb-2"></i>
                    <h6 class="fw-bold text-dark mb-0">الديون</h6>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Purchases" asp-action="Index" class="card border-0 shadow-sm p-4 text-decoration-none h-100 cashier-card text-center">
                    <i class="bi bi-box-seam fs-2 text-danger mb-2"></i>
                    <h6 class="fw-bold text-dark mb-0">المشتريات</h6>
                </a>
            </div>
        </div>

        <div class="mt-4 p-4 bg-white shadow-sm rounded-4 border-0">
            <div class="row text-center g-3">
                <div class="col-6 col-md-6 border-end">
                    <h6 class="text-muted small">مبيعاتك اليوم</h6>
                    <h4 class="fw-bold text-primary mb-0">@Model.TodaySales.ToString("N0")</h4>
                </div>
                <div class="col-6 col-md-6">
                    <h6 class="text-muted small">نواقص المخزن</h6>
                    <h4 class="fw-bold text-danger mb-0">@Model.LowStockCount</h4>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* تحسينات الشاشات الصغيرة */
    @@media (max-width: 768px) {
        .card-body { padding: 1rem !important; }
        .btn-lg { padding: 0.75rem !important; font-size: 1rem; }
    }

    .cashier-card { 
        transition: all 0.2s; 
        border-radius: 15px;
    }
    .cashier-card:hover { 
        background-color: #f8f9fa; 
        transform: scale(1.03); 
    }
    .admin-action-btn { transition: 0.2s; }
    .admin-action-btn:hover { background-color: #f0f0f0 !important; }
    .btn-primary-pos { background: #00b894; color: white; border-radius: 12px; border: none; }
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-danger-subtle { background-color: #f8d7da; }
</style>