@model alnakhil.Models.PricingSetting

@{
    ViewData["Title"] = "إعدادات التسعير";
}

<div class="container-fluid py-4 px-md-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="bi bi-sliders me-2 text-info"></i> إعدادات التسعير العامة</h3>
        <p class="text-muted small mb-0">هذه الإعدادات تُستخدم كأساس لحساب سعر البيع المقترح لكل المنتجات.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4" style="max-width: 500px;">
        <div class="card-body p-4">
            <form asp-action="Update" method="post">

                <div class="mb-4">
                    <label class="form-label fw-bold">نسبة الربح الافتراضية</label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" name="profitPercentage"
                               value="@Model.ProfitPercentage" class="form-control" required />
                        <span class="input-group-text">%</span>
                    </div>
                    <small class="text-muted">تُضاف على سعر الشراء لاقتراح سعر البيع تلقائياً.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">نسبة الضريبة</label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" name="taxPercentage"
                               value="@Model.TaxPercentage" class="form-control" />
                        <span class="input-group-text">%</span>
                    </div>
                    <small class="text-muted">
                        غير مُفعّلة حالياً في حساب سعر البيع — محجوزة للاستخدام المستقبلي.
                    </small>
                </div>

                <button type="submit" class="btn btn-info text-white fw-bold px-4 shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> حفظ الإعدادات
                </button>
            </form>
        </div>
    </div>
</div>
