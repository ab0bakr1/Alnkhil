@model IEnumerable<alnakhil.ViewModels.DebtSummaryVM>

@{
    ViewData["Title"] = "إدارة الديون";
}

<div class="container-fluid py-4 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border-start border-danger border-5">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-credit-card-2-back me-2 text-danger"></i> مركز إدارة الديون</h3>
            <p class="text-muted small mb-0">متابعة المبالغ المستحقة للموردين والمبالغ المتبقية عند العملاء.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-dark btn-sm px-3 rounded-pill">
                <i class="bi bi-file-earmark-pdf me-1"></i> تقرير الديون الكلي
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4 text-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-bottom border-danger border-3">
                <small class="text-muted d-block mb-1">إجمالي ديون الموردين (علينا 🔴)</small>
                <h3 class="fw-bold text-danger mb-0">
                    @Model.Where(d => d.Type == alnakhil.ViewModels.DebtType.Payable).Sum(d => d.TotalRemaining).ToString("N0") <small style="font-size: 14px">RY</small>
                </h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-bottom border-success border-3">
                <small class="text-muted d-block mb-1">إجمالي مستحقات العملاء (لنا 🟢)</small>
                <h3 class="fw-bold text-success mb-0">
                    @Model.Where(d => d.Type == alnakhil.ViewModels.DebtType.Payable).Sum(d => d.TotalRemaining).ToString("N0") <small style="font-size: 14px">RY</small>
                </h3>
            </div> 
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4 py-3">الجهة / الاسم</th>
                        <th class="text-center">نوع العلاقة</th>
                        <th class="text-center">عدد الفواتير</th>
                        <th class="text-center">إجمالي المبلغ المتبقي</th>
                        <th class="text-center">أقرب موعد سداد</th>
                        <th class="pe-4 text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var isOverdue = d.NearestDueDate.HasValue && d.NearestDueDate < DateTime.Now;
                        var isPayable = d.Type == alnakhil.ViewModels.DebtType.Payable;

                        <tr class="@(isOverdue ? "bg-warning bg-opacity-10" : "")">
                            <td class="ps-4">
                                <div class="fw-bold text-dark fs-6">@d.Name</div>
                                <div class="text-muted small">سجل مالي نشط</div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill px-3 @(isPayable ? "bg-danger bg-opacity-10 text-danger border-danger" : "bg-success bg-opacity-10 text-success border-success") border">
                                    <i class="bi @(isPayable ? "bi-arrow-down-left" : "bi-arrow-up-right") me-1"></i>
                                    @(isPayable ? "مورد (علينا)" : "عميل (لنا)")
                                </span>
                            </td>
                            <td class="text-center fw-bold">
                                <span class="badge bg-light text-dark border rounded-pill">@d.InvoicesCount فواتير</span>
                            </td>
                            <td class="text-center">
                                <h6 class="fw-bold mb-0 @(isPayable ? "text-danger" : "text-success")">
                                    @d.TotalRemaining.ToString("N2") <small style="font-size: 10px">RY</small>
                                </h6>
                            </td>
                            <td class="text-center">
                                @if (d.NearestDueDate.HasValue)
                                {
                                    <div class="small @(isOverdue ? "text-danger fw-bold" : "text-muted")">
                                        <i class="bi bi-clock-history me-1"></i>
                                        @d.NearestDueDate.Value.ToString("yyyy-MM-dd")
                                    </div>
                                    @if(isOverdue) { <small class="text-danger" style="font-size: 10px;">(متأخر)</small> }
                                }
                                else
                                {
                                    <span class="text-muted opacity-50 small">غير محدد</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="Details"
                                   asp-route-name="@d.Name"
                                   asp-route-type="@d.Type"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                    كشف حساب <i class="bi bi-chevron-left ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .table tbody tr:hover { background-color: #fcfcfc; }
    .badge { font-weight: 600; }
</style>