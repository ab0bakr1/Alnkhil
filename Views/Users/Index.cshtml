@model IEnumerable<alnakhil.ViewModels.UserWithRoleVM>

@{
    ViewData["Title"] = "إدارة طاقم العمل";
}

<div class="container-fluid px-0 px-md-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">👥 إدارة طاقم العمل</h3>
            <p class="text-muted small mb-0">يمكنك إضافة، تعديل، أو صلاحيات الكاشير والمدراء من هنا.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-pos px-4 py-2 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i> إضافة كاشير جديد
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white text-center">
                <small class="text-muted d-block">إجمالي الطاقم</small>
                <h4 class="fw-bold mb-0">@Model.Count()</h4>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white text-center border-start border-success border-4">
                <small class="text-muted d-block">نشط الآن</small>
                <h4 class="fw-bold mb-0 text-success">@Model.Count()</h4>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 border-0 text-muted small">المستخدم</th>
                        <th class="border-0 text-muted small">رقم الهاتف</th>
                        <th class="border-0 text-muted small">الصلاحية</th>
                        <th class="border-0 text-muted small">حالة الحساب</th>
                        <th class="pe-4 border-0 text-muted small text-end">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="https://ui-avatars.com/api/?name=@user.Email&background=random" 
                                         class="rounded-circle" width="35" height="35" alt="">
                                    <div>
                                        <div class="fw-bold text-dark small">@user.Email</div>
                                        <small class="text-muted" style="font-size: 11px;">ID: #@user.Id.Substring(0, 8)</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-dark small"><i class="bi bi-telephone me-1 opacity-50"></i> @(string.IsNullOrEmpty(user.Phone) ? "غير مسجل" : user.Phone)</span>
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 rounded-pill">
                                        <i class="bi bi-shield-lock-fill me-1"></i> مدير نظام
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 rounded-pill">
                                        <i class="bi bi-person-badge me-1"></i> كاشير
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success border-0 small">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i> نشط
                                </span>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-circle" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li><a class="dropdown-item py-2" asp-action="Details" asp-route-id="@user.Id"><i class="bi bi-eye me-2"></i> التفاصيل</a></li>
                                        <li><a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@user.Id"><i class="bi bi-pencil me-2 text-primary"></i> تعديل البيانات</a></li>
                                        @if (user.Role != "Admin")
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item py-2 text-danger" asp-action="Delete" asp-route-id="@user.Id"><i class="bi bi-trash me-2"></i> حذف المستخدم</a></li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* ألوان مخصصة للتصميم */
    .bg-primary-subtle { background-color: #e0f2fe !important; }
    .bg-danger-subtle { background-color: #fee2e2 !important; }
    .bg-success-subtle { background-color: #dcfce7 !important; }
    
    .table thead th {
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table tbody tr {
        transition: background-color 0.2s;
    }

    .table tbody tr:hover {
        background-color: #fcfcfc;
    }

    .btn-primary-pos {
        background-color: #00b894;
        color: white;
        border: none;
        border-radius: 8px;
        transition: 0.3s;
    }

    .btn-primary-pos:hover {
        background-color: #00a383;
        transform: translateY(-1px);
    }
</style> 