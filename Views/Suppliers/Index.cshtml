@model List<alnakhil.Models.Supplier>

@{
    ViewData["Title"] = "الموردين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">الموردين</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> إضافة مورد
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>رقم الهاتف</th>
                    <th>عدد فواتير الشراء</th>
                    <th class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">لا يوجد موردين حتى الآن</td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>@supplier.Name</td>
                            <td>@(supplier.Phone ?? "-")</td>
                            <td>@supplier.Purchases.Count</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> تعديل
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
