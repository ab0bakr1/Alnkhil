@model alnakhil.ViewModels.SaleVM

@{
    ViewData["Title"] = "إنشاء فاتورة مبيعات";
}

<div class="container-fluid py-4 px-md-4">
    <!-- شريط العنوان والاختصارات -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border-start border-primary border-5">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-cart-plus me-2 text-primary"></i> فاتورة بيع جديدة</h3>
            <p class="text-muted small mb-0">تسجيل عمليات البيع الفوري وإدارة حسابات العملاء.</p>
        </div>
        <div class="d-none d-lg-flex flex-wrap gap-2">
            <span class="badge bg-light text-dark border p-2"><kbd class="bg-secondary">F2</kbd> باركود</span>
            <span class="badge bg-light text-dark border p-2"><kbd class="bg-secondary">F4</kbd> تعليق</span>
            <span class="badge bg-light text-dark border p-2"><kbd class="bg-secondary">F9</kbd> حفظ</span>
            <span class="badge bg-light text-dark border p-2"><kbd class="bg-secondary">+</kbd> زيادة</span>
            <span class="badge bg-light text-dark border p-2"><kbd class="bg-secondary">-</kbd> إنقاص</span>
            <span class="badge bg-light text-dark border p-2"><kbd class="bg-secondary">Del</kbd> حذف</span>
        </div>
        <div asp-validation-summary="All" class="text-danger small fw-bold"></div>
    </div>

    <form asp-action="Create" method="post" id="posForm">
        @Html.AntiForgeryToken()

        <!-- بيانات الفاتورة الأساسية -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">رقم الفاتورة</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-hash"></i></span>
                            <input class="form-control border-light bg-light fw-bold text-muted" value="تلقائي (S-XXXX)" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">اسم العميل</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                            <input asp-for="CustomerName" class="form-control border-light bg-light" placeholder="أدخل اسم العميل (نقدي)" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">تاريخ البيع</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-calendar-event"></i></span>
                            <input type="date" class="form-control border-light bg-light" value="@DateTime.Today.ToString("yyyy-MM-dd")" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">حالة الفاتورة / طريقة الدفع</label>
                        <select asp-for="PaymentStatus" class="form-select form-select-sm border-light bg-light fw-bold text-primary">
                            <option value="Paid">✅ مدفوع (نقداً)</option>
                            <option value="Deferred">⚠️ آجل (دين)</option>
                            <option value="Unpaid">❌ غير مدفوع</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول الأصناف -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam me-2"></i> قائمة المنتجات</h6>
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addRow()">
                    <i class="bi bi-plus-lg me-1"></i> إضافة صنف جديد
                </button>
            </div>
            <div class="table-responsive" style="min-height: 380px;">
                <table class="table align-middle" style="table-layout: fixed;">
                    <thead class="bg-light">
                        <tr class="small text-muted text-uppercase">
                            <th style="width: 32%;" class="ps-4">المنتج / البحث</th>
                            <th style="width: 20%;">الباركود</th>
                            <th style="width: 12%;" class="text-center">الكمية</th>
                            <th style="width: 15%;" class="text-center text-success">سعر الوحدة</th>
                            <th style="width: 16%;" class="text-center text-primary">المجموع</th>
                            <th style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="rows">
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ملخص الحسابات والإجمالي -->
        <div class="row g-4 mb-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 small text-dark"><i class="bi bi-calculator me-1"></i> الضرائب والخصومات</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted">المجموع الفرعي</label>
                                <div class="input-group input-group-sm">
                                    <input id="subtotal" class="form-control border-light bg-light fw-bold" readonly value="0.00" />
                                    <span class="input-group-text bg-light border-0 small">RY</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted">الضريبة (0%)</label>
                                <div class="input-group input-group-sm">
                                    <input id="taxAmount" class="form-control border-light bg-light text-success fw-bold" readonly value="0.00" />
                                    <span class="input-group-text bg-light border-0 small text-success">RY</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted">مبلغ الخصم</label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="DiscountAmount" class="form-control border-light bg-light text-danger fw-bold" type="number" step="0.01" value="0" oninput="calculateTotals()" />
                                    <span class="input-group-text bg-light border-0 small text-danger">RY</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                        <span class="opacity-75 small text-uppercase fw-bold mb-2">إجمالي مبلغ الفاتورة</span>
                        <h2 class="fw-bold mb-3" id="totalAmount">0.00 <small style="font-size: 14px">RY</small></h2>
                        
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-light fw-bold py-2 shadow-sm text-primary" onclick="submitSale()">
                                <i class="bi bi-cloud-check me-2"></i> حفظ الفاتورة (F9)
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm border-0 opacity-75" onclick="suspendSale()">
                                <i class="bi bi-pause-fill me-1"></i> تعليق الفاتورة (F4)
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light btn-sm border-0 opacity-75">
                                <i class="bi bi-x-circle me-1"></i> إلغاء والرجوع
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .form-control:focus, .form-select:focus { box-shadow: none; border-color: #0d6efd !important; }

    .table thead th { font-weight: 600; padding: 12px 8px; }
    .table tbody td { padding: 12px 8px; }

    .table-active {
        background-color: rgba(13, 110, 253, 0.08) !important;
        border-right: 4px solid #0d6efd !important;
    }

    .suggestions {
        z-index: 1050;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        border: none;
        border-radius: 8px;
        overflow: hidden;
        max-height: 260px;
        overflow-y: auto;
    }

    .list-group-item-action:hover {
        background-color: #f0f7ff;
        color: #0d6efd;
    }

    kbd {
        padding: 2px 5px;
        font-size: 0.75rem;
        border-radius: 4px;
    }
</style>

@section Scripts {
<script>
    let activeRow = null;
    let itemIndex = 0;

    /* ================== ADD ROW ================== */
    function addRow() {
        const row = `
        <tr onclick="setActiveRow(this)">
            <td style="position:relative">
                <input type="text"
                       class="form-control product-name-input"
                       placeholder="اسم المنتج أو البحث..."
                       autocomplete="off" />

                <input type="hidden" name="Items[${itemIndex}].ProductId" class="product-id" />
                <input type="hidden" name="Items[${itemIndex}].UnitPrice" class="product-unit-price" value="0" />

                <div class="list-group position-absolute w-100 d-none suggestions"></div>
            </td>

            <td>
                <input type="text"
                       name="Items[${itemIndex}].ProductBarcode"
                       class="form-control barcode-input"
                       placeholder="الباركود أو بالماسح"
                       autocomplete="off" />
            </td>

            <td>
                <input type="number"
                       name="Items[${itemIndex}].Quantity"
                       class="form-control quantity-input text-center"
                       min="1"
                       value="1" />
            </td>

            <td>
                <input type="text"
                       class="form-control unit-price-display bg-light text-success fw-bold text-center"
                       readonly
                       placeholder="0.00" />
            </td>

            <td>
                <input type="text"
                       class="form-control line-total-display bg-light text-primary fw-bold text-center"
                       readonly
                       placeholder="0.00" />
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn btn-danger btn-sm"
                        onclick="removeRow(this)">✖</button>
            </td>
        </tr>`;

        document.getElementById("rows").insertAdjacentHTML("beforeend", row);
        itemIndex++;

        const newRow = document.querySelector("#rows tr:last-child");
        setActiveRow(newRow);

        bindRowEvents(newRow);
        calculateTotals();

        // التركيز على الباركود للصف الجديد
        newRow.querySelector(".barcode-input")?.focus();
    }

    /* ================== ACTIVE ROW ================== */
    function setActiveRow(row) {
        document.querySelectorAll("#rows tr").forEach(r => r.classList.remove("table-active"));
        if (!row) return;
        row.classList.add("table-active");
        activeRow = row;
    }

    /* ================== KEYBOARD SHORTCUTS ================== */
    document.addEventListener("keydown", function (e) {
        // إذا كان الفوكس على حقل نصي والزر F2 أو F4 أو F9 لا نمنعه
        if (e.key === "F2") {
            e.preventDefault();
            const lastRow = document.querySelector("#rows tr:last-child");
            if (lastRow) {
                setActiveRow(lastRow);
                lastRow.querySelector(".barcode-input")?.focus();
            } else {
                addRow();
            }
            return;
        }

        if (e.key === "F4") {
            e.preventDefault();
            suspendSale();
            return;
        }

        if (e.key === "F9") {
            e.preventDefault();
            submitSale();
            return;
        }

        if (!activeRow) return;

        // اختصارات تعديل الكمية وحذف الصف
        const isEditingInput = ["INPUT", "SELECT", "TEXTAREA"].includes(document.activeElement.tagName);
        const qtyInput = activeRow.querySelector(".quantity-input");

        if (e.key === "+") {
            if (!isEditingInput || document.activeElement === qtyInput) {
                e.preventDefault();
                qtyInput.value = (parseInt(qtyInput.value) || 0) + 1;
                calculateTotals();
            }
        } else if (e.key === "-") {
            if (!isEditingInput || document.activeElement === qtyInput) {
                e.preventDefault();
                const cur = parseInt(qtyInput.value) || 1;
                if (cur > 1) {
                    qtyInput.value = cur - 1;
                    calculateTotals();
                }
            }
        } else if (e.key === "Delete") {
            if (!isEditingInput) {
                e.preventDefault();
                activeRow.remove();
                activeRow = document.querySelector("#rows tr:last-child");
                if (activeRow) setActiveRow(activeRow);
                calculateTotals();
            }
        } else if (e.key === "Escape") {
            e.preventDefault();
            qtyInput.value = 1;
            calculateTotals();
        }
    });

    /* ================== BIND ROW EVENTS ================== */
    function bindRowEvents(row) {
        const barcodeInput = row.querySelector(".barcode-input");
        const nameInput = row.querySelector(".product-name-input");
        const qtyInput = row.querySelector(".quantity-input");
        const suggestions = row.querySelector(".suggestions");

        // باركود (قارئ باركود أو ضغط Enter)
        barcodeInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const code = this.value.trim();
                if (!code) return;

                fetch(`/Sales/SearchProducts?query=${encodeURIComponent(code)}`)
                    .then(r => r.json())
                    .then(products => {
                        if (products && products.length > 0) {
                            fillRow(row, products[0]);
                        }
                    });
            }
        });

        // بحث بالاسم مع نافذة الاقتراحات
        nameInput.addEventListener("input", function () {
            const query = this.value.trim();

            if (query.length < 2) {
                suggestions.innerHTML = "";
                suggestions.classList.add("d-none");
                return;
            }

            fetch(`/Sales/SearchProducts?query=${encodeURIComponent(query)}`)
                .then(r => r.json())
                .then(products => {
                    suggestions.innerHTML = "";
                    if (!products || products.length === 0) {
                        suggestions.classList.add("d-none");
                        return;
                    }

                    suggestions.classList.remove("d-none");
                    products.forEach(p => {
                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center";
                        btn.innerHTML = `
                            <div>
                                <span class="fw-bold text-dark">${p.name}</span>
                                <small class="text-muted d-block">${p.barcode || 'بدون باركود'}</small>
                            </div>
                            <span class="badge bg-light text-primary border">${p.salePrice.toFixed(2)} RY</span>
                        `;
                        btn.onclick = (ev) => {
                            ev.preventDefault();
                            fillRow(row, p);
                        };
                        suggestions.appendChild(btn);
                    });
                });
        });

        // إغلاق الاقتراحات عند النقر خارجها
        document.addEventListener("click", function (e) {
            if (!row.contains(e.target)) {
                suggestions.classList.add("d-none");
            }
        });

        // تغيير الكمية
        qtyInput.addEventListener("input", calculateTotals);
    }

    /* ================== FILL ROW ================== */
    function fillRow(row, product) {
        // التحقق من تكرار الصنف
        const existingRow = findExistingRow(product.id);
        if (existingRow && existingRow !== row) {
            const qty = existingRow.querySelector(".quantity-input");
            qty.value = (parseInt(qty.value) || 0) + 1;
            row.remove();
            setActiveRow(existingRow);
            calculateTotals();
            return;
        }

        row.querySelector(".product-name-input").value = product.name;
        row.querySelector(".barcode-input").value = product.barcode || "";
        row.querySelector(".product-id").value = product.id;
        row.querySelector(".product-unit-price").value = product.salePrice;

        row.querySelector(".unit-price-display").value = product.salePrice.toFixed(2);
        row.querySelector(".suggestions").classList.add("d-none");

        calculateTotals();

        // إضافة صف جديد تلقائياً وتفعيل التركيز للكاشير السريع
        addRow();
    }

    /* ================== FIND EXISTING ROW ================== */
    function findExistingRow(productId) {
        let found = null;
        document.querySelectorAll("#rows tr").forEach(row => {
            const pid = row.querySelector(".product-id");
            if (pid && pid.value == productId) {
                found = row;
            }
        });
        return found;
    }

    /* ================== REMOVE ROW ================== */
    function removeRow(btn) {
        const row = btn.closest("tr");
        row.remove();
        activeRow = document.querySelector("#rows tr:last-child");
        if (activeRow) setActiveRow(activeRow);
        calculateTotals();
    }

    /* ================== CALCULATE TOTALS ================== */
    function calculateTotals() {
        let subtotal = 0;

        document.querySelectorAll("#rows tr").forEach(row => {
            const qty = parseFloat(row.querySelector(".quantity-input")?.value) || 0;
            const price = parseFloat(row.querySelector(".product-unit-price")?.value) || 0;
            const lineTotal = qty * price;

            const lineTotalDisplay = row.querySelector(".line-total-display");
            if (lineTotalDisplay) {
                lineTotalDisplay.value = lineTotal.toFixed(2);
            }

            subtotal += lineTotal;
        });

        const taxRate = 0; // نسبة الضريبة 0%
        const taxAmount = subtotal * (taxRate / 100);
        const discountAmount = parseFloat(document.querySelector('[name="DiscountAmount"]')?.value) || 0;
        const total = subtotal + taxAmount - discountAmount;

        document.getElementById("subtotal").value = subtotal.toFixed(2);
        document.getElementById("taxAmount").value = taxAmount.toFixed(2);
        document.getElementById("totalAmount").innerHTML = `${total.toFixed(2)} <small style="font-size: 14px">RY</small>`;
    }

    /* ================== SUBMIT SALE ================== */
    function submitSale() {
        const items = [];
        document.querySelectorAll("#rows tr").forEach(row => {
            const productId = row.querySelector(".product-id")?.value;
            const qty = row.querySelector(".quantity-input")?.value;
            const price = row.querySelector(".product-unit-price")?.value;

            if (productId && productId !== "0" && productId !== "") {
                items.push({
                    ProductId: parseInt(productId),
                    Quantity: parseInt(qty) || 1,
                    UnitPrice: parseFloat(price) || 0
                });
            }
        });

        if (items.length === 0) {
            alert("⚠️ يرجى إضافة منتج واحد على الأقل قبل الحفظ");
            return;
        }

        const formData = new FormData();
        formData.append("CustomerName", document.querySelector('[name="CustomerName"]').value || "");
        formData.append("PaymentStatus", document.querySelector('[name="PaymentStatus"]').value);
        formData.append("DiscountAmount", document.querySelector('[name="DiscountAmount"]').value || "0");

        items.forEach((item, i) => {
            formData.append(`Items[${i}].ProductId`, item.ProductId);
            formData.append(`Items[${i}].Quantity`, item.Quantity);
            formData.append(`Items[${i}].UnitPrice`, item.UnitPrice);
        });

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        const submitBtn = document.querySelector('button[onclick="submitSale()"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i> جاري الحفظ...';
        }

        fetch("/Sales/Create", {
            method: "POST",
            headers: { "RequestVerificationToken": token },
            body: formData
        }).then(r => {
            if (r.redirected) {
                window.location.href = r.url;
            } else {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-cloud-check me-2"></i> حفظ الفاتورة (F9)';
                }
                return r.text().then(text => {
                    alert("فشل الحفظ: " + text);
                });
            }
        }).catch(err => {
            alert("حدث خطأ أثناء الاتصال بالسيرفر");
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-cloud-check me-2"></i> حفظ الفاتورة (F9)';
            }
        });
    }

    /* ================== SUSPEND SALE ================== */
    function suspendSale() {
        const items = [];
        document.querySelectorAll("#rows tr").forEach(row => {
            const productId = row.querySelector(".product-id")?.value;
            const qty = row.querySelector(".quantity-input")?.value;
            const price = row.querySelector(".product-unit-price")?.value;

            if (productId && productId !== "0" && productId !== "") {
                items.push({
                    productId: parseInt(productId),
                    quantity: parseInt(qty) || 1,
                    unitPrice: parseFloat(price) || 0
                });
            }
        });

        if (items.length === 0) {
            alert("⚠️ لا توجد أصناف لتعليقها");
            return;
        }

        const paymentStatusVal = document.querySelector('[name="PaymentStatus"]').value;
        const data = {
            customerName: document.querySelector('[name="CustomerName"]').value || "",
            paymentStatus: paymentStatusVal === "Deferred" ? 2 : 1,
            discountAmount: parseFloat(document.querySelector('[name="DiscountAmount"]').value) || 0,
            items: items
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        fetch("/Sales/Suspend", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                alert("✅ تم تعليق الفاتورة بنجاح");
                location.reload();
            } else {
                alert("حدث خطأ أثناء تعليق الفاتورة");
            }
        })
        .catch(err => {
            alert("حدث خطأ أثناء الاتصال بالسيرفر");
        });
    }

    /* ================== INIT ================== */
    document.addEventListener("DOMContentLoaded", function () {
        addRow();
    });
</script>
}