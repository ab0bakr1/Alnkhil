    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="flex-grow-1">
                        <h6 class="text-muted small fw-bold mb-1">🔴 التزامات للموردين (علينا)</h6>
                        <h3 class="fw-bold mb-0 text-danger">@Model.PayableDebts.ToString("N2") <small class="fs-6">RY</small></h3>
                    </div>
                    <i class="bi bi-arrow-down-left-circle fs-1 text-danger opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="flex-grow-1">
                        <h6 class="text-muted small fw-bold mb-1">🟢 مستحقات عند العملاء (لنا)</h6>
                        <h3 class="fw-bold mb-0 text-success">@Model.ReceivableDebts.ToString("N2") <small class="fs-6">RY</small></h3>
                    </div>
                    <i class="bi bi-arrow-up-right-circle fs-1 text-success opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <h6 class="fw-bold mb-0 text-dark">📈 تحليل الأداء المالي (آخر 6 أشهر)</h6>
        </div>
        <div class="card-body">
            <div style="height: 350px;">
                <canvas id="chart"></canvas>
            </div>
        </div>
    </div>
</div>

<style>
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-5px); }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('chart');

new Chart(ctx, {
    type: 'line',
    data: {
        labels: @Html.Raw(Json.Serialize(Model.Months)),
        datasets: [
            {
                label: 'المبيعات',
                data: @Html.Raw(Json.Serialize(Model.SalesByMonth)),
                borderColor: '#198754',
                backgroundColor: 'rgba(25, 135, 84, 0.1)',
                fill: true,
                tension: 0.4,
                borderWidth: 3
            },
            {
                label: 'المشتريات',
                data: @Html.Raw(Json.Serialize(Model.PurchasesByMonth)),
                borderColor: '#dc3545',
                backgroundColor: 'rgba(220, 53, 69, 0.1)',
                fill: true,
                tension: 0.4,
                borderWidth: 3
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'top', labels: { font: { family: 'Cairo, sans-serif' } } }
        },
        scales: {
            y: { beginAtZero: true, grid: { display: false } },
            x: { grid: { display: false } }
        }
    }
});
</script>
}