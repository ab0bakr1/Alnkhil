            <i class="bi bi-speedometer2 text-primary fs-3"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-0">نظرة عامة على الأداء</h3>
            <p class="text-muted small mb-0">متابعة المبيعات، المخزون، والديون في مكان واحد.</p>
        </div>
    </div>

