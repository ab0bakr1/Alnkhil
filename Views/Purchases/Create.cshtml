@model alnakhil.ViewModels.PurchaseVM
@{
    ViewData["Title"] = "إنشاء فاتورة شراء";
}

<div class="container-fluid py-4 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border-start border-success border-5">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-bag-plus me-2 text-success"></i> فاتورة شراء جديدة</h3>
            <p class="text-muted small mb-0">تسجيل بضاعة واردة للمخزن وتحديث بيانات الموردين.</p>
        </div>
        <div asp-validation-summary="All" class="text-danger small fw-bold"></div>
    </div>

    <form asp-action="Create" method="post" id="purchaseForm">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">رقم الفاتورة</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-hash"></i></span>
                            <input asp-for="InvoiceNumber" class="form-control border-light bg-light fw-bold" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">اسم المورد</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-truck"></i></span>
                            <input asp-for="SupplierName" class="form-control border-light bg-light" placeholder="أدخل اسم المورد" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">تاريخ الشراء</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-calendar-event"></i></span>
                            <input asp-for="PurchaseDate" type="date" class="form-control border-light bg-light" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">حالة الفاتورة</label>
                        <select asp-for="PaymentStatus" id="paymentStatusSelect" class="form-select form-select-sm border-light bg-light fw-bold">
                            <option value="Paid">✅ مدفوعة (كاش)</option>
                            <option value="Deferred">⚠️ دين آجل</option>
                            <option value="Unpaid">❌ غير مدفوعة</option>
                        </select>
                    </div>

                    <!-- تاريخ الاستحقاق (يظهر عند اختيار دين آجل) -->
                    <div class="col-12" id="dueDateContainer" style="display: none;">
                        <div class="p-3 bg-danger-subtle border border-danger-subtle rounded-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2 text-danger">
                                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                                <div>
                                    <span class="fw-bold small">الفاتورة مسجلة كـ (دين آجل)</span>
                                    <span class="text-muted small d-block d-sm-inline ms-sm-2">— يجب كتابة وتحديد تاريخ الاستحقاق لسداد الدين للمورد</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <label asp-for="DueDate" class="form-label mb-0 small fw-bold text-dark text-nowrap">
                                    تاريخ الاستحقاق <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-sm" style="min-width: 210px;">
                                    <span class="input-group-text bg-white border-danger text-danger"><i class="bi bi-calendar-check"></i></span>
                                    <input asp-for="DueDate" type="date" id="dueDateInput" class="form-control border-danger bg-white fw-bold" />
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="DueDate" class="text-danger small fw-bold mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam me-2"></i> الأصناف الموردة</h6>
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addRow()">
                    <i class="bi bi-plus-lg me-1"></i> إضافة صنف جديد
                </button>
            </div>
            <div class="table-responsive" style="min-height: 420px;">
                <table class="table align-middle" style="table-layout: fixed;">
                    <thead class="bg-light">
                        <tr class="small text-muted text-uppercase">
                            <th style="width: 22%;" class="ps-4">المنتج / البحث</th>
                            <th style="width: 12%;">الباركود</th>
                            <th style="width: 8%;" class="text-center">الكمية</th>
                            <th style="width: 12%;">التصنيف</th>
                            <th style="width: 12%;">تاريخ الانتهاء</th>
                            <th style="width: 14%;">سعر الشراء (الإجمالي)</th>
                            <th style="width: 12%;" class="text-success">سعر الوحدة</th>
                            <th style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        </tbody>
                </table>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 small">الضرائب والخصومات</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">الضريبة (%)</label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="TaxPercentage" class="form-control border-light bg-light" oninput="calculateTotal()" />
                                    <span class="input-group-text bg-light border-0">%</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">الخصم (%)</label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="DiscountPercentage" class="form-control border-light bg-light" oninput="calculateTotal()" />
                                    <span class="input-group-text bg-light border-0 text-danger">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                        <span class="opacity-75 small text-uppercase fw-bold mb-2">إجمالي مبلغ الفاتورة</span>
                        <h2 class="fw-bold mb-3" id="totalAmount">0.00 <small style="font-size: 14px">RY</small></h2>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-light fw-bold py-2 shadow-sm">
                                <i class="bi bi-cloud-check me-2"></i> حفظ الفاتورة
                            </button>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-light btn-sm border-0 opacity-75">إلغاء</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="Subtotal" id="Subtotal" />
        <input type="hidden" asp-for="TaxAmount" id="TaxAmount" />
        <input type="hidden" asp-for="DiscountAmount" id="DiscountAmount" />
        <input type="hidden" asp-for="TotalAmount" id="TotalAmount" />
    </form>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .form-control:focus, .form-select:focus { box-shadow: none; border-color: #0d6efd !important; }
    
    .suggestions {
        z-index: 1050;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border: none;
        border-radius: 8px;
        overflow: hidden;
    }
    .list-group-item-action:hover { background-color: #f0f7ff; color: #0d6efd; }
    
    .table thead th { font-weight: 600; padding: 12px 8px; }
    .table tbody td { padding: 12px 8px; }
</style>

@section Scripts {

    <script>
    let itemIndex = 0;

    // بناء قائمة التصنيفات مرة واحدة
    const categoriesOptions = `@foreach(var c in (ViewBag.Categories as IEnumerable<alnakhil.Models.Category> ?? Enumerable.Empty<alnakhil.Models.Category>()) ) { <text><option value="@c.Id">@c.Name</option></text> }`;

    document.addEventListener("DOMContentLoaded", () => {
        addRow();
        toggleDueDate();
    });

    function toggleDueDate() {
        const statusSelect = document.getElementById("paymentStatusSelect");
        const container = document.getElementById("dueDateContainer");
        const input = document.getElementById("dueDateInput");

        if (!statusSelect || !container || !input) return;

        if (statusSelect.value === "Deferred") {
            container.style.display = "block";
            input.setAttribute("required", "required");
        } else {
            container.style.display = "none";
            input.removeAttribute("required");
            input.classList.remove("is-invalid");
        }
    }

    const statusSelectEl = document.getElementById("paymentStatusSelect");
    if (statusSelectEl) {
        statusSelectEl.addEventListener("change", toggleDueDate);
    }

    const dueDateInputEl = document.getElementById("dueDateInput");
    if (dueDateInputEl) {
        dueDateInputEl.addEventListener("input", function () {
            if (this.value) {
                this.classList.remove("is-invalid");
            }
        });
    }

    function addRow() {
        const row = `
    <tr>
        <td style="position:relative">
            <!-- اسم المنتج -->
            <input name="Items[${itemIndex}].ProductName"
                type="text"
                class="form-control product-search"
                placeholder="اسم المنتج أو البحث بالباركود" />

            <!-- ProductId (nullable) -->
            <input type="hidden"
                name="Items[${itemIndex}].ProductId"
                class="product-id" />

            <div class="list-group position-absolute w-100 d-none suggestions"></div>
        </td>
        <td>
            <input name="Items[${itemIndex}].Barcode"
                type="text"
                class="form-control"
                placeholder="اختياري" />
        </td>

        <td>
            <input name="Items[${itemIndex}].Quantity"
                type="number"
                class="form-control"
                min="1"
                value="1"
                oninput="updateUnitPrice(this.closest('tr').querySelector('.purchase-price-input')); calculateTotal()" />
        </td>

        <td>
            <select name="Items[${itemIndex}].CategoryId"
                class="form-control category-select">
                <option value="">-- اختياري --</option>
                ${categoriesOptions}
            </select>
        </td>

        <td>
            <input name="Items[${itemIndex}].ExpiryDate"
                type="date"
                class="form-control" />
        </td>

        <td>
            <input name="Items[${itemIndex}].PurchasePrice"
                type="number"
                class="form-control purchase-price-input"
                step="0.01"
                oninput="updateUnitPrice(this); calculateTotal()" />
        </td>

        <td>
            <input type="text"
                class="form-control unit-price-display bg-light text-success fw-bold"
                readonly
                placeholder="0.00"
                title="يتم تخزين سعر الوحدة تلقائياً" />
        </td>

        <td>
            <button type="button"
                    class="btn btn-danger"
                    onclick="removeRow(this)">✖</button>
        </td>
    </tr>`;
        document.getElementById("itemsBody").insertAdjacentHTML("beforeend", row);
        itemIndex++;
    }

    function removeRow(btn) {
        btn.closest("tr").remove();
        calculateTotal();
    }

    function updateUnitPrice(priceInput) {
        const row = priceInput.closest("tr");
        const qty = parseFloat(row.querySelector('input[name$=".Quantity"]').value) || 1;
        const price = parseFloat(priceInput.value) || 0;
        const unit = qty > 0 ? (price / qty) : price;
        const display = row.querySelector('.unit-price-display');
        if (display) display.value = unit.toFixed(2);
    }


    function calculateTotal() {
        let subtotal = 0;

        document.querySelectorAll("#itemsBody tr").forEach(row => {
            const price = parseFloat(row.querySelector('input[name$=".PurchasePrice"]').value) || 0;
            subtotal += price; // سعر الكرتون كامل
        });

        const taxPerc = parseFloat(document.getElementById("TaxPercentage").value) || 0;
        const discountPerc = parseFloat(document.getElementById("DiscountPercentage").value) || 0;

        const taxAmount = subtotal * taxPerc / 100;
        const discountAmount = subtotal * discountPerc / 100;

        const total = subtotal + taxAmount - discountAmount;

        // 👇 ربط مع ViewModel
        document.getElementById("Subtotal").value = subtotal;
        document.getElementById("TaxAmount").value = taxAmount;
        document.getElementById("DiscountAmount").value = discountAmount;
        document.getElementById("TotalAmount").value = total;

        document.getElementById("totalAmount").textContent =
            total.toLocaleString('ar-EG', { style: 'currency', currency: 'SAR' });
    }


    // البحث عن المنتجات
        document.addEventListener("input", function (e) {
            if (!e.target.classList.contains("product-search")) return;

            const input = e.target;
            const cell = input.closest("td");
            const list = cell.querySelector(".suggestions");
            const hidden = cell.querySelector(".product-id");

            hidden.value = ""; // منتج جديد افتراضيًا

            if (input.value.length < 2) {
                list.classList.add("d-none");
                return;
            }

            fetch(`/Purchases/Search?q=${encodeURIComponent(input.value)}`)
                .then(r => r.json())
                .then(data => {
                    list.innerHTML = "";
                    list.classList.remove("d-none");

                    data.forEach(p => {
                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "list-group-item list-group-item-action";
                        btn.textContent = `${p.name} (${p.barcode})`;
                        btn.onclick = () => {
                            input.value = p.name;
                            hidden.value = p.id;

                            const row = input.closest("tr");

                            // 👇 تعبئة تلقائية
                            const priceInput = row.querySelector('.purchase-price-input');
                            priceInput.value = p.purchasePrice ?? 0;
                            updateUnitPrice(priceInput);

                            row.querySelector('input[name$=".Barcode"]').value = p.barcode ?? "";

                            // تعبئة التصنيف
                            const catSelect = row.querySelector('.category-select');
                            if (catSelect && p.categoryId) {
                                catSelect.value = p.categoryId;
                            }

                            list.classList.add("d-none");
                            calculateTotal();
                        };
                        list.appendChild(btn);
                    });
                });
        });
        document.getElementById("purchaseForm")?.addEventListener("submit", function (e) {
            const statusSelect = document.getElementById("paymentStatusSelect");
            const dueDateInput = document.getElementById("dueDateInput");

            // التحقق من تاريخ الاستحقاق إذا كانت الفاتورة دين آجل
            if (statusSelect && statusSelect.value === "Deferred") {
                if (!dueDateInput || !dueDateInput.value.trim()) {
                    e.preventDefault();
                    if (dueDateInput) {
                        dueDateInput.classList.add("is-invalid");
                        dueDateInput.focus();
                    }
                    alert("⚠️ الفاتورة مسجلة كـ (دين آجل)، يجب كتابة وتحديد تاريخ الاستحقاق!");
                    return false;
                }
            }

            // التحقق من وجود أصناف
            const rows = document.querySelectorAll("#itemsBody tr");
            if (rows.length === 0) {
                e.preventDefault();
                alert("⚠️ يجب إضافة صنف واحد على الأقل في الفاتورة.");
                return false;
            }

            let hasValidItem = false;
            for (let r of rows) {
                const nameInput = r.querySelector('input[name$=".ProductName"]');
                const priceInput = r.querySelector('input[name$=".PurchasePrice"]');
                const qtyInput = r.querySelector('input[name$=".Quantity"]');

                if (nameInput && nameInput.value.trim()) {
                    hasValidItem = true;
                    if (!priceInput || parseFloat(priceInput.value) <= 0) {
                        e.preventDefault();
                        alert("⚠️ يرجى التأكد من كتابة سعر شراء صحيح للأصناف.");
                        priceInput?.focus();
                        return false;
                    }
                    if (!qtyInput || parseFloat(qtyInput.value) <= 0) {
                        e.preventDefault();
                        alert("⚠️ يرجى التأكد من كتابة كمية صحيحة للأصناف.");
                        qtyInput?.focus();
                        return false;
                    }
                }
            }

            if (!hasValidItem) {
                e.preventDefault();
                alert("⚠️ يرجى إدخال اسم صنف واحد على الأقل.");
                return false;
            }
        });

</script>
}
 