@model alnakhil.Models.Category

@{
    ViewData["Title"] = "إضافة تصنيف جديد";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small hover-primary">
                    <i class="bi bi-arrow-right me-1"></i> العودة لقائمة التصنيفات
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-3 border-0">
                    <h5 class="card-title text-white mb-0 fw-bold text-center">
                        <i class="bi bi-folder-plus me-2"></i> تعريف تصنيف جديد
                    </h5>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create" method="post" id="createCategoryForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-dark small">اسم التصنيف (مثلاً: معلبات، منظفات..)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted">
                                    <i class="bi bi-tag"></i>
                                </span>
                                <input asp-for="Name" class="form-control bg-light border-start-0 rounded-end-3 py-2 px-3" 
                                       placeholder="أدخل الاسم هنا..." autocomplete="off" autofocus />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="alert alert-light border-0 small text-muted mb-4 py-2">
                            <i class="bi bi-info-circle me-1 text-primary"></i> 
                            سيظهر هذا الاسم كخيار عند إضافة منتجات جديدة للمخزن.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> حـفـظ التصنيف
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted btn-sm mt-2">إلغاء العملية</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4 opacity-50">
                <i class="bi bi-shield-check text-success"></i>
                <small class="text-dark">نظام النخيل لإدارة المخازن - @DateTime.Now.Year</small>
            </div>
        </div>
    </div>
</div>

<style>
    .input-group-text { border-color: #dee2e6; }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
        background-color: #fff !important;
    }
    .hover-primary:hover { color: #0d6efd !important; transition: 0.3s; }
    .card { border: 1px solid rgba(0,0,0,0.05) !important; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}