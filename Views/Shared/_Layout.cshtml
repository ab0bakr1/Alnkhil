@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - النخيل Smart POS</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary-color: #00b894;
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 80px;
            --bg-light: #f8f9fa;
            --sidebar-bg: #1e272e;
        }

        body { font-family: 'Cairo', sans-serif; background-color: var(--bg-light); overflow-x: hidden; }

        /* Sidebar Styles */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            right: 0;
            top: 0;
            background: var(--sidebar-bg);
            color: #fff;
            transition: all 0.3s ease-in-out;
            z-index: 1050;
            box-shadow: -4px 0 10px rgba(0,0,0,0.1);
        }

        /* حالة التصغير */
        .sidebar.collapsed { width: var(--sidebar-collapsed-width); }
        .sidebar.collapsed .sidebar-header h4, 
        .sidebar.collapsed .sidebar-header small,
        .sidebar.collapsed .nav-link span,
        .sidebar.collapsed .admin-label { display: none; }
        .sidebar.collapsed .nav-link { justify-content: center; padding: 0.8rem; margin: 0.2rem 0.5rem; }
        .sidebar.collapsed .nav-link i { margin: 0; font-size: 1.4rem; }

        .sidebar-header { padding: 1.5rem 1rem; text-align: center; border-bottom: 1px solid #2d3436; white-space: nowrap; overflow: hidden; }
        
        .nav-link {
            color: #b2bec3;
            padding: 0.8rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 8px;
            margin: 0.2rem 1rem;
            transition: 0.2s;
            white-space: nowrap;
        }
        .nav-link:hover, .nav-link.active { background: var(--primary-color); color: #fff; }

        /* Main Content */
        .main-content { 
            margin-right: var(--sidebar-width); 
            padding: 1.5rem; 
            transition: all 0.3s ease-in-out; 
            min-height: 100vh;
        }
        .main-content.expanded { margin-right: var(--sidebar-collapsed-width); }

        /* Top Bar */
        .top-bar {
            background: white;
            border-bottom: 1px solid #eee;
            margin-bottom: 1.5rem;
            border-radius: 12px;
            padding: 0.6rem 1.2rem;
        }

        /* Responsive Configuration */
        @@media (max-width: 992px) {
            .sidebar { right: calc(-1 * var(--sidebar-width)); }
            .sidebar.show { right: 0; }
            .main-content { margin-right: 0 !important; }
            .overlay {
                display: none;
                position: fixed;
                top: 0; left: 0; width: 100%; height: 100%;
                background: rgba(0,0,0,0.5);
                z-index: 1040;
            }
            .overlay.show { display: block; }
        }

        .btn-toggle {
            background: #f1f2f6;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
            color: var(--sidebar-bg);
            cursor: pointer;
        }
        .btn-toggle:hover { background: #dfe4ea; }

        .btn-primary-pos { background: var(--primary-color); border: none; color: white; border-radius: 10px; font-weight: 600; }
        .btn-primary-pos:hover { background: #00a383; color: white; }
    </style>
</head>
<body>

    <div class="overlay" id="sidebarOverlay"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h4 class="fw-bold mb-0 text-white">🌴 النخيل <span class="text-success">S</span></h4>
            <small class="text-muted">نظام إدارة السوبر ماركت</small>
        </div>
        
        <div class="mt-4">
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i> <span>لوحة التحكم</span>
            </a>
            
            <a class="nav-link" asp-controller="Products" asp-action="Index">
                <i class="bi bi-archive"></i> <span>المخزون</span>
            </a>

            <a class="nav-link" asp-controller="Sales" asp-action="Index">
                <i class="bi bi-wallet2"></i> <span>المبيعات</span>
            </a>

            <a class="nav-link" asp-controller="Debts" asp-action="Index">
                <i class="bi bi-person-exclamation"></i> <span>الديون</span>
            </a>
            <a class="nav-link" asp-controller="Home" asp-action="System"> 
                <i class="bi bi-person-exclamation"></i> <span>الاعدادات</span>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <hr class="mx-3 opacity-25">
                <div class="px-4 mb-2 small text-uppercase text-muted admin-label" style="font-size: 10px;">الإدارة</div>
                <a class="nav-link text-warning" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i> <span>التقارير التحليلية</span>
                </a>
                <a class="nav-link text-warning" asp-controller="Dashboard" asp-action="Today">
                    <i class="bi bi-graph-up-arrow"></i> <span>التقارير التحليلية اليومية</span>
                </a>
                <a class="nav-link text-warning" asp-controller="Dashboard" asp-action="monthly">
                    <i class="bi bi-graph-up-arrow"></i> <span>التقارير التحليلية الشهرية</span>
                </a>
            }
        </div>
    </aside>

    <main class="main-content" id="mainContent">
        <header class="top-bar d-flex justify-content-between align-items-center shadow-sm">
            
            <div class="d-flex align-items-center gap-3">
                <button class="btn-toggle" id="sidebarToggle">
                    <i class="bi bi-arrow-left-right fs-4"></i>
                </button>
                <div class="welcome-msg d-none d-md-block">
                    <span class="text-muted small fw-bold">📅 @DateTime.Now.ToString("dd MMMM yyyy")</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 gap-md-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Sales" asp-action="Create" class="btn btn-primary-pos px-2 px-md-4 shadow-sm btn-sm btn-md-base">
                        <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">فاتورة جديدة</span>
                    </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="User" asp-action="Index" class="btn btn-primary-pos px-2 px-md-4 shadow-sm btn-sm btn-md-base"> 
                        <i class="bi bi-person-plus-fill"></i> <span class="d-none d-sm-inline"> اضافة كاشير </span>
                    </a>
                }

                <div class="vr mx-2"></div>

                    <div class="dropdown">
                        <div class="d-flex align-items-center gap-2" data-bs-toggle="dropdown" style="cursor: pointer;">
                            <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=00b894&color=fff" 
                                 class="rounded-circle border border-2 border-white shadow-sm" width="35" height="35">
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-start shadow border-0 mt-3">
                            <li class="px-3 py-2 border-bottom mb-2">
                                <div class="fw-bold small">@User.Identity.Name</div>
                                <small class="text-muted">@(User.IsInRole("Admin") ? "مدير النظام" : "كاشير")</small>
                            </li>
                            <li><a class="dropdown-item py-2" href="#"><i class="bi bi-person me-2"></i> ملفي الشخصي</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    <button class="dropdown-item text-danger py-2">
                                        <i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }else{
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-dark px-4 rounded-pill shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> تسجيل الدخول
                    </a>
                }
            </div>
        </header>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const toggleBtn = document.getElementById('sidebarToggle');
        const overlay = document.getElementById('sidebarOverlay');

        toggleBtn.addEventListener('click', () => {
            if (window.innerWidth > 992) {
                // وضع الكمبيوتر: تصغير وتكبير
                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');
            } else {
                // وضع الجوال: إظهار وإخفاء بالكامل
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            }
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
        });

        // تصغير القائمة تلقائياً في الشاشات المتوسطة (التابلت)
        if (window.innerWidth <= 1200 && window.innerWidth > 992) {
            sidebar.classList.add('collapsed');
            mainContent.classList.add('expanded');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>